{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "env": {
    "GEMINI_API_KEY": "AIzaSyBsN9IJpwB-oFsM4oX84PNVxd7X4ekHghM",
    "GEMINI_MODEL": "gemini-1.5-flash"
  }
}
